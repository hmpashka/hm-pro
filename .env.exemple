# Copier en .env (chmod 600 .env) et remplir. Ne jamais mettre .env dans Git.
DOMAINE=pro.hmphotographie.fr
BETTER_AUTH_URL=https://pro.hmphotographie.fr
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32   (À GARDER AUSSI HORS DU SERVEUR : sans elle, les données chiffrées sont perdues)
CHIFFREMENT_CLE=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Site des licences et sa clé de service (même valeur que '_service' => ['cle' => ...] dans le config.php de live.hm)
LIVE_URL=https://live.hmphotographie.fr
LIVE_CLE_SERVICE=
# Jeton de n8n pour /api/interne/... : openssl rand -hex 32
N8N_JETON=
