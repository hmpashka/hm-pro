# HTTPS automatique. Derrière Cloudflare (proxy orange) : Caddy n'accepte que les IP de Cloudflare (pare-feu ufw)
# et reprend l'IP réelle du visiteur depuis CF-Connecting-IP.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAINE} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}
	reverse_proxy app:3000 {
		# seule source d'IP pour l'appli (limites d'essais, journal) : jamais un en-tête envoyé par le visiteur
		header_up X-Real-IP {client_ip}
		header_up -CF-Connecting-IP
		header_up -X-Forwarded-For
	}
}
